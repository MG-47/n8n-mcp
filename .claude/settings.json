{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/sol-review.sh:*)",
      "Bash(.claude/scripts/orch-state.sh:*)"
    ],
    "deny": [
      "Bash(codex:*)",
      "Bash(npx codex:*)",
      "Bash(*dangerously-bypass-approvals-and-sandbox*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/orchestration.conf)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/scripts/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/orchestration.conf)",
      "Write(.claude/hooks/**)",
      "Write(.claude/scripts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" } ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-agent.sh" } ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh" } ] }
    ]
  }
}
